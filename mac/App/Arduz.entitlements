<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox: OBLIGATORIO para cualquier app de la Mac App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Cliente de red: el juego abre wss://gw.arduzao.com/ws. Sin esto no conecta NUNCA. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Sin microfono: Arduz no tiene voz de party. -->
</dict>
</plist>
